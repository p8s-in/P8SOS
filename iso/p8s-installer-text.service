# Text installer as the fallback when the graphical screen can't start
# (started by p8s-installer-kiosk.service's OnFailure). The web page keeps
# running, so another computer's browser can still be used.
[Unit]
Description=P8S OS installer (text, fallback)
Conflicts=getty@tty1.service p8s-installer-kiosk.service

[Service]
Type=idle
ExecStart=/usr/local/sbin/p8s-install --no-web
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=TERM=linux
Restart=always
RestartSec=2
