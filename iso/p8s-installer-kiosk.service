# The graphical installer on this computer's screen: Firefox full screen in
# the cage kiosk compositor (mouse and keyboard), as the live user. If the
# screen can't start (no graphics driver), the text installer takes over.
[Unit]
Description=P8S OS graphical installer (screen)
After=p8s-installer-web.service systemd-user-sessions.service live-config.service
Wants=p8s-installer-web.service
ConditionKernelCommandLine=p8s.installer
ConditionKernelCommandLine=p8s.gui
Conflicts=getty@tty1.service p8s-installer-text.service
Before=getty@tty1.service
StartLimitIntervalSec=180
StartLimitBurst=3
OnFailure=p8s-installer-text.service

[Service]
User=installer
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=MOZ_ENABLE_WAYLAND=1 XDG_SESSION_TYPE=wayland
ExecStartPre=/bin/sh -c 'for i in $(seq 40); do curl -sf -o /dev/null http://127.0.0.1:8099/api/hello && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/cage -s -- /usr/bin/firefox-esr --kiosk http://127.0.0.1:8099/
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
