[Unit]
Description=P8S OS management daemon
Documentation=file:///usr/share/doc/p8sd/README.md
After=network-online.target libvirtd.service zfs.target
Wants=network-online.target
Requires=libvirtd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/p8sd serve -config /etc/p8s/p8sd.json
Restart=on-failure
RestartSec=3
# Runs as root: zfs clone/destroy and /dev/zvol access need it in Phase 1.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/var/lib/p8s

[Install]
WantedBy=multi-user.target
