[Unit]
Description=P8S OS management daemon
Documentation=file:///usr/share/doc/p8sd/README.md
After=network-online.target libvirtd.service zfs.target
# Wants, not Requires: p8sd keeps running (and keeps answering) when libvirtd
# stops or restarts — with Requires, stopping libvirtd stopped p8sd for good
Wants=network-online.target libvirtd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/p8sd serve -config /etc/p8s/p8sd.json
Restart=always
RestartSec=3
# Runs as root and manages the whole server: ZFS, libvirt, packages (Ceph),
# /etc/ceph, /etc/fstab (NFS), iSCSI, network. So no ProtectSystem/ProtectHome:
# with ProtectSystem=full, /usr and /etc were read-only and "Install Ceph"
# failed inside dpkg ("Sub-process /usr/bin/dpkg returned an error code (1)").
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
